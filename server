#!/usr/bin/env php
<?php
use ClanCats\Station\PHPServer\Server;
use ClanCats\Station\PHPServer\Request;
use ClanCats\Station\PHPServer\Response;
use ClanCats\Station\PHPServer\Router;

require 'vendor/autoload.php';

define('SERVER_START_TIME', time());

// Router initialisieren
$router = new Router();

// Startseite definieren
$router->get('/', function(Request $request) {
    $html = "<h1>PHP Raw Socket Server Demo (mit Router)</h1>";
    $html .= "<p><strong>Method:</strong> " . htmlspecialchars($request->getMethod()) . "</p>";
    $html .= "<p><strong>URI:</strong> " . htmlspecialchars($request->getUri()) . "</p>";
    $html .= "<h3>Headers:</h3><ul>";
    foreach ($request->getHeaders() as $key => $val) {
        $html .= "<li><strong>" . htmlspecialchars($key) . ":</strong> " . htmlspecialchars($val) . "</li>";
    }
    $html .= "</ul>";
    $html .= "<hr><p><a href='/health'>Check Server Health (JSON)</a></p>";

    return new Response($html);
});


// Health-Check-Route definieren
$router->get('/health', function(Request $request) {
    $data = [
        'status' => 'online',
        'php_version' => PHP_VERSION,
        'uptime_seconds' => time() - SERVER_START_TIME
    ];
    return new Response(json_encode($data), 200, ['Content-Type' => 'application/json']);
});

$router->get('/status/{code}', function(Request $request, array $params) {
    $code = (int)($params[0] ?? 200);
    
    $html = "<h1>Status Code: {$code}</h1>";
    $html .= "<p>Dies ist ein Test für den HTTP-Statuscode {$code}.</p>";
    $html .= "<hr><p><a href='/'>Zurück zur Startseite</a></p>";

    return new Response($html, $code);
});


// Server starten (Port 8080)
$server = new Server('127.0.0.1', 8080);

$server->listen(function(Request $request) use ($router) {
    // Schönes Logging im Terminal bei jedem Aufruf
    echo "[" . date('Y-m-d H:i:s') . "] " . $request->getMethod() . " " . $request->getUri() . "\n";

    // Anfrage an den Router übergeben
    return $router->resolve($request);
});
